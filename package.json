{
  "name": "metra-libs",
  "version": "1.0.0",
  "description": "Libs for Metra apps",
  "type": "module",
  "repository": "ide-a/metra-libs.git",
  "scripts": {
    "build:all": "lerna run build",
    "build:changed": "lerna run build --since HEAD~1",
    "check-pipeline-readiness": "yarn run lint:changed && yarn run test:changed && yarn run build:changed",
    "check:pr:readiness": "yarn run syncpack:fix && yarn run lint:all:fix && yarn run test:all && yarn run build:all",
    "clean:deps": "lerna clean -y && rm -rf node_modules",
    "clean:deps:reinstall": "yarn run clean:deps && yarn install",
    "create-package": "node scripts/create-package.js",
    "lint:all": "lerna run lint",
    "lint:all:fix": "lerna run lint:fix",
    "lint:changed": "lerna run lint --since HEAD~1",
    "lint:changed:fix": "lerna run lint:fix --since HEAD~1",
    "prepare": "husky",
    "publish": "lerna publish from-git --yes",
    "syncpack:fix": "syncpack fix-mismatches && syncpack format",
    "syncpack:lint": "syncpack lint",
    "syncpack:list": "syncpack list-mismatches",
    "test:all": "lerna run test",
    "test:changed": "lerna run test --since HEAD~1",
    "version": "lerna version --conventional-commits --yes --create-release github"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@eslint/js": "^9.9.1",
    "@types/node": "^25.0.9",
    "@typescript-eslint/utils": "^8.53.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lerna": "^9.0.3",
    "prettier": "^3.8.0",
    "syncpack": "^13.0.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.3.0"
  },
  "author": "",
  "bugs": "https://github.com/ide-a/metra-libs/issues",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ide-a/metra-libs#readme",
  "packageManager": "yarn@4.6.0",
  "pre-commit": [
    "pre-commit"
  ],
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
